# LLM (OpenAI-compatible). Never commit real keys.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
RUNTIME_MODEL=deepseek-flash
SEMANTIC_MODEL=
PLANNER_MODEL=
ANALYTICS_MODEL=
RESPONSE_MODEL=
LLM_TIMEOUT_SECONDS=60
# 'none' keeps the model from spending output budget on hidden reasoning.
LLM_REASONING_EFFORT=none

# PostgreSQL hot Statcast store (read-only analytics plane)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=baseball_analytics
POSTGRES_USER=baseball_readonly
POSTGRES_PASSWORD=

# Historical Parquet archive (read via DuckDB, read-only)
PARQUET_ARCHIVE_PATH=/path/to/your/parquet_archive

# Runtime state
RUNTIME_DIR=.runtime

# Optional search API (leave blank to use public search backends)
WEB_SEARCH_ENDPOINT=
WEB_SEARCH_API_KEY=
