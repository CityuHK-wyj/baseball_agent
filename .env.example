# LLM provider (values are never committed; leave blank locally and fill in .env)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Authoritative product-path model. Official DeepSeek API id.
DEEPSEEK_MODEL=deepseek-flash
# Single shared runtime-model override (wins over DEEPSEEK_MODEL when set).
RUNTIME_MODEL=

# Per-role model selection (optional; each falls back to RUNTIME_MODEL / DEEPSEEK_MODEL).
PLANNER_MODEL=
JUDGE_MODEL=
RESPONSE_MODEL=
SEMANTIC_MODEL=
# Per-operation SDK timeout (does not bound total call duration).
LLM_TIMEOUT_SECONDS=30
# True end-to-end model-call deadline covering request + provider wait + stream + retry.
LLM_DEADLINE_SECONDS=90
LLM_STREAM=1
# Structured roles default to no hidden reasoning so bounded output is emitted within
# max_tokens; raise to low/medium/high for quality-sensitive deployments (latency cost).
LLM_REASONING_EFFORT=none
# Role-specific output bounds (reasoning tokens count against these).
SEMANTIC_MAX_TOKENS=1024
PLANNER_MAX_TOKENS=2048
RESPONSE_MAX_TOKENS=1024
JUDGE_MAX_TOKENS=512

# Dual semantic runtime (legacy pipeline; roles share the runtime model by default).
SEMANTIC_EXTRACTOR_MODEL=
SEMANTIC_REVIEWER_MODEL=

# PostgreSQL hot-data store (read-only analytics data plane)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=baseball_analytics
POSTGRES_USER=baseball_readonly
POSTGRES_PASSWORD=
POSTGRES_ADMIN_PASSWORD=

# Local storage
PARQUET_ARCHIVE_PATH=./data_loader/parquet_archive
ARTIFACT_STORAGE_PATH=.runtime/artifacts
OPERATIONAL_STORE_PATH=.runtime/operational.db

# Shared Knowledge (separate logical store; PostgreSQL uses a dedicated `knowledge` schema)
KNOWLEDGE_STORE_PATH=.runtime/knowledge.db
KNOWLEDGE_SEED_PATH=./knowledge/seed
KNOWLEDGE_SOURCE_PATH=./knowledge/sources

# Optional live web recovery (search API). Leave blank to keep web recovery
# interface-only; the runtime then reports it is not configured instead of pretending.
WEB_SEARCH_ENDPOINT=
WEB_SEARCH_API_KEY=
