# LLM provider (values are never committed; leave blank locally and fill in .env)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Per-agent model selection (optional; each falls back to DEEPSEEK_MODEL when blank)
PLANNER_MODEL=
JUDGE_MODEL=
RESPONSE_MODEL=
SEMANTIC_MODEL=
LLM_TIMEOUT_SECONDS=30

# PostgreSQL hot-data store (read-only analytics data plane)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=baseball_analytics
POSTGRES_USER=baseball_readonly
POSTGRES_PASSWORD=
POSTGRES_ADMIN_PASSWORD=

# Local storage
PARQUET_ARCHIVE_PATH=./data_loader/parquet_archive
ARTIFACT_STORAGE_PATH=.runtime/artifacts
OPERATIONAL_STORE_PATH=.runtime/operational.db

# Shared Knowledge (separate logical store; PostgreSQL uses a dedicated `knowledge` schema)
KNOWLEDGE_STORE_PATH=.runtime/knowledge.db
KNOWLEDGE_SEED_PATH=./knowledge/seed
KNOWLEDGE_SOURCE_PATH=./knowledge/sources
